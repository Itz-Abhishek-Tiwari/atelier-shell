diff --git a/src/window/burn/BurnTheme.hpp b/src/window/burn/BurnTheme.hpp
new file mode 100644
index 0000000..b36c556
--- /dev/null
+++ b/src/window/burn/BurnTheme.hpp
@@ -0,0 +1,80 @@
+#pragma once
+
+// Atelier patch: the fire in the burn style takes its colours from the desktop theme
+// (~/.config/atelier/theme.json, written by atelier-theme) instead of fixed orange.
+// Read once, when the plugin loads; a theme change shows the next time the plugin loads.
+#include <algorithm>
+#include <array>
+#include <cstdio>
+#include <cstdlib>
+#include <fstream>
+#include <sstream>
+#include <string>
+
+#include <nlohmann/json.hpp>
+
+namespace burn_theme {
+    using Rgb = std::array<float, 3>;
+
+    inline Rgb hex(const std::string& s, Rgb fallback) {
+        if (s.size() != 7 || s[0] != '#') return fallback;
+        unsigned v = 0;
+        if (std::sscanf(s.c_str() + 1, "%x", &v) != 1) return fallback;
+        return {static_cast<float>((v >> 16) & 255) / 255.f, static_cast<float>((v >> 8) & 255) / 255.f,
+                static_cast<float>(v & 255) / 255.f};
+    }
+    inline Rgb mix(Rgb a, Rgb b, float t) {
+        return {a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t};
+    }
+    inline Rgb scale(Rgb a, float k) { return {a[0] * k, a[1] * k, a[2] * k}; }
+    // saturate the pastel accent into a flame colour whose brightest channel is 1
+    inline Rgb flame_of(Rgb c) {
+        const float L = 0.2126f * c[0] + 0.7152f * c[1] + 0.0722f * c[2];
+        Rgb o{std::clamp(L + (c[0] - L) * 1.7f, 0.f, 4.f), std::clamp(L + (c[1] - L) * 1.7f, 0.f, 4.f),
+              std::clamp(L + (c[2] - L) * 1.7f, 0.f, 4.f)};
+        const float m = std::max({o[0], o[1], o[2], 0.001f});
+        return scale(o, 1.f / m);
+    }
+    inline std::string vec3(Rgb c) {
+        char b[96];
+        std::snprintf(b, sizeof b, "vec3(%.4f,%.4f,%.4f)", c[0], c[1], c[2]);
+        return b;
+    }
+
+    inline std::array<std::pair<std::string, std::string>, 8> table() {
+        Rgb accent{1.f, 0.19f, 0.012f}, crust{0.019f, 0.017f, 0.015f}, mantle{0.12f, 0.061f, 0.031f};
+        bool themed = false;
+        if (const char* home = std::getenv("HOME")) {
+            std::ifstream f(std::string{home} + "/.config/atelier/theme.json");
+            if (f) {
+                try {
+                    const auto j = nlohmann::json::parse(f);
+                    const auto& c = j.at("colors");
+                    accent = hex(c.value("accent", ""), accent);
+                    crust = hex(c.value("crust", ""), crust);
+                    mantle = hex(c.value("mantle", ""), mantle);
+                    themed = true;
+                } catch (...) {}
+            }
+        }
+        const Rgb F = themed ? flame_of(accent) : accent;
+        const Rgb coalA = themed ? mix(scale(mantle, 0.9f), scale(F, 0.12f), 0.5f) : mantle;
+        const Rgb coalB = themed ? scale(crust, 0.75f) : crust;
+        const Rgb hot = themed ? scale(mix(F, {1.f, 1.f, 1.f}, 0.45f), 0.62f) : Rgb{0.55f, 0.35f, 0.055f};
+        return {{{"@COAL_A@", vec3(coalA)},
+                 {"@COAL_B@", vec3(coalB)},
+                 {"@FLAME@", vec3(F)},
+                 {"@HOT@", vec3(hot)},
+                 {"@CREASE@", vec3(scale(F, 0.22f))},
+                 {"@GLOW_EDGE@", vec3(scale(F, 0.53f))},
+                 {"@EMBER@", vec3(scale(F, 0.91f))},
+                 {"@HOT_EMBER@", vec3(themed ? mix(F, {1.f, 1.f, 1.f}, 0.55f) : Rgb{1.f, 0.74f, 0.32f})}}};
+    }
+
+    inline std::string apply(std::string s) {
+        static const auto T = table();
+        for (const auto& [k, v] : T)
+            for (size_t p = 0; (p = s.find(k, p)) != std::string::npos; p += v.size()) s.replace(p, k.size(), v);
+        return s;
+    }
+}
