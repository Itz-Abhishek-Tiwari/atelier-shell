[Desktop Entry]
Type=Service
MimeType=application/octet-stream;
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
X-KDE-Priority=TopLevel
Actions=airdrop;
Icon=network-wireless

[Desktop Action airdrop]
Name=Send with AirDrop
Icon=network-wireless
Exec=sh -c '"$HOME/.config/quickshell/scripts/airdrop-send.sh" "$@"' airdrop-send %F
