#!/bin/sh
# atelier-gpu — choose which GPU(s) Hyprland opens at login.
#
#   atelier-gpu amd      Hyprland uses only the AMD iGPU. The NVIDIA dGPU can then power down
#                        (saves about 1 W), but the HDMI port is wired to it, so HDMI stops working.
#   atelier-gpu both     Hyprland opens both GPUs (default). HDMI works, the dGPU stays awake.
#   atelier-gpu status   Show the saved choice and the GPUs found.
#
# The choice is stored in ~/.config/atelier/gpu and read by greeter/session.sh when you log in,
# so it takes effect at your NEXT login. aquamarine reads AQ_DRM_DEVICES before the config loads,
# so it cannot be changed from hypr/*.lua. Needs the refreshed session script:
#   sudo greeter/install.sh --refresh
set -eu

cfg="${XDG_CONFIG_HOME:-$HOME/.config}/atelier/gpu"

case "${1:-status}" in
    amd|both)
        mkdir -p "$(dirname "$cfg")"
        printf '%s\n' "$1" >"$cfg"
        echo "GPU mode set to '$1'. It applies at your next login."
        ;;
    status)
        echo "saved mode: $( [ -f "$cfg" ] && cat "$cfg" || echo 'both (default)')"
        for c in /sys/class/drm/card[0-9]*; do
            [ -e "$c/device/vendor" ] || continue
            case "$(cat "$c/device/vendor")" in
                0x1002) v=AMD ;; 0x10de) v=NVIDIA ;; 0x8086) v=Intel ;; *) v=other ;;
            esac
            echo "$(basename "$c"): $v"
        done
        echo "Hyprland currently runs with: ${AQ_DRM_DEVICES:-all GPUs}"
        ;;
    *)
        echo "usage: atelier-gpu amd|both|status" >&2
        exit 2
        ;;
esac
