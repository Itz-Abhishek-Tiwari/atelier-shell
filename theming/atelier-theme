SPOTIFY_LIVE_JS = """// atelierLive: recolour Spotify live when atelier-theme rewrites colors.css / user.css.
// Generated by atelier-theme. Polls the two local files (only while Spotify is visible).
(function atelierLive() {
  const files = ["colors.css", "user.css"];
  const last = {};
  async function check() {
    if (document.hidden) return;
    for (const f of files) {
      try {
        const r = await fetch(f + "?atelier=" + Date.now(), { cache: "no-store" });
        if (!r.ok) continue;
        const text = await r.text();
        if (last[f] === undefined) { last[f] = text; continue; }
        if (text === last[f]) continue;
        last[f] = text;
        const old = document.querySelector('link.userCSS[href^="' + f + '"]');
        if (!old) continue;
        const next = old.cloneNode();
        next.href = f + "?atelier=" + Date.now();
        next.onload = () => old.remove();          // swap after load: no unstyled flash
        old.after(next);
      } catch (e) {}
    }
  }
  check();
  setInterval(check, 1500);
  document.addEventListener("visibilitychange", check);
})();
"""


