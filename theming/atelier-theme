    m = re.search(r"(?m)^extensions[ \t]*=[ \t]*(.*)$", cfg.read_text() if cfg.exists() else "")
    exts = [e for e in (m.group(1).strip() if m else "").split("|") if e]
    has_live = "atelierLive.js" in exts
    if not has_live:
        exts.append("atelierLive.js")
    ini_merge(cfg, {
