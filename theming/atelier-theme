#!/usr/bin/env python3
"""atelier-theme — one palette, applied everywhere.

    atelier-theme list            JSON list of themes (used by the Quickshell picker)
    atelier-theme current         id of the active theme
    atelier-theme apply <id>      apply a theme system-wide
    atelier-theme toggle-mode     switch between the light and dark side of the theme
    atelier-theme setup           one-time: install the VS Code theme extensions
    atelier-theme wallpaper [img] regenerate wallpaper-dark/-light from the wallpaper (re-applies if active)

Themes are JSON files in <repo>/theming/themes/ and ~/.config/atelier/themes/.
Targets: Quickshell, Hyprland, kitty, Ghostty, VS Code (+ Antigravity), GTK 3/4 +
gsettings (GNOME apps), Qt/KDE apps (qt6ct palette + kdeglobals), starship, zsh (syntax highlighting, autosuggestions, fzf, bat), btop,
Spotify (spicetify theme 'atelier'), Discord (Vesktop/Vencord/Equicord/Legcord/BetterDiscord theme).
"""
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

HOME = Path.home()
CONF = HOME / ".config"
REPO_THEMES = Path(os.path.realpath(__file__)).parent / "themes"
USER_THEMES = CONF / "atelier/themes"
STATE_DIR = CONF / "atelier"
STATE = STATE_DIR / "state.json"


# ── helpers ──────────────────────────────────────────────────────────────────
def hex6(c):
    return c.lstrip("#")[:6].lower()


def rgb(c):
    h = hex6(c)
    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))


def write(path, text):
    """Write a file, replacing a symlink (old NamiThemes links) instead of following it."""
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.is_symlink():
        path.unlink()
    tmp = path.with_name(path.name + ".atelier-tmp")
    tmp.write_text(text)
    tmp.replace(path)


def run(*cmd):
    try:
        subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=15)
    except Exception:
        pass


def spawn(*cmd):
    try:
        subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    except Exception:
        pass


def themes():
    out = {}
    for d in (REPO_THEMES, USER_THEMES):
        if d.is_dir():
            for f in sorted(d.glob("*.json")):
                try:
                    t = json.loads(f.read_text())
                    out[t["id"]] = t
                except Exception as e:
                    print(f"skipping {f}: {e}", file=sys.stderr)
    return out


def state():
    try:
        return json.loads(STATE.read_text())
    except Exception:
        return {}


def save_state(s):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    STATE.write_text(json.dumps(s, indent=2))


def contrast(a, b):
    """WCAG contrast ratio of two #rrggbb colours."""
    def lum(h):
        r, g, b = (_lin(x / 255) for x in rgb(h))
        return 0.2126 * r + 0.7152 * g + 0.0722 * b
    x, y = lum(a), lum(b)
    return (max(x, y) + 0.05) / (min(x, y) + 0.05)


def deepen(col, ink, target=4.5):
    """`col`, darkened (same hue and chroma, lower OKLCH lightness) until `ink` on it reaches
    `target` contrast. Used for filled backgrounds (selection, active chips, buttons)."""
    if contrast(col, ink) >= target:
        return col
    L, C, H = oklch_of(*rgb(col))
    out = col
    while L > 0.05 and contrast(out, ink) < target:
        L -= 0.015
        out = oklch_hex(L, C, H)
    return out


def resolved(t):
    """Theme with derived roles: accent (text/icons), accentFill + onAccent (filled backgrounds).
    Text on a filled colour is always the theme's light ink: dark text on a mid-tone accent looked
    muddy (wallpaper themes), so the fill is deepened until the light ink reaches 4.5:1."""
    c = dict(t["colors"])
    c["accent"] = c.get(t.get("accent", "mauve"), t.get("accent", "#cba6f7"))
    c["onAccent"] = c["text"] if t["variant"] == "dark" else c["base"]
    c["accentFill"] = deepen(c["accent"], c["onAccent"])
    c["redFill"] = deepen(c["red"], c["onAccent"])
    return c


def icon_theme(t):
    """The theme's icon set (a Colloid variant) if installed, else plain Colloid-Dark/Light."""
    icons = t.get("icons") or ""
    icon_dirs = [HOME / ".local/share/icons", HOME / ".icons", Path("/usr/share/icons")]
    if not icons or not any((d / icons).is_dir() for d in icon_dirs):
        icons = "Colloid-Dark" if t["variant"] == "dark" else "Colloid-Light"
    return icons


