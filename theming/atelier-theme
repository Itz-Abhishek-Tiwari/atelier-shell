def qt_roles(t, c, state):
    """22 QPalette roles for qt6ct, in QPalette::ColorRole order."""
    def q(h, a=0xFF): return f"#{a:02x}{hex6(h)}"
    dark = t["variant"] == "dark"
    text = {"active": c["text"], "inactive": c["overlay1"], "disabled": c["overlay0"]}[state]
    hi = c["accentFill"] if state != "disabled" else c["surface0"]
    return [
        q(text), q(c["surface1"] if state != "disabled" else c["surface0"]), q(c["surface2"]), q(c["surface0"]),
        q(c["crust"]), q(c["mantle"]), q(text), q(c["text"]), q(text),             # WindowText..ButtonText
        q(c["base"]), q(c["mantle"]), q(c["crust"]), q(hi), q(c["onAccent"] if state != "disabled" else c["overlay0"]),
        q(c["blue"]), q(c["lavender"]), q(c["mantle"]), q("#ffffff"),               # Link, LinkVisited, AlternateBase, NoRole
        q(c["base"]), q(c["text"]), q(c["text"], 0x80), q(c["accent"]),             # ToolTipBase/Text, Placeholder, Accent
    ]


