def set_vscode_theme(settings_path, theme_name, dark, colors=None, syntax=None):
    p = Path(settings_path)
    if not p.parent.exists():
        return
    text = p.read_text() if p.exists() else "{}"
    try:
        data = json.loads(text) if text.strip() else {}
        data["workbench.colorTheme"] = theme_name
        data["window.autoDetectColorScheme"] = False
        if colors is not None:
            data["workbench.colorCustomizations"] = colors
        # palette syntax only under the themes that need it; extension themes keep their own
        scope = f"[{theme_name}]"                         # must match the theme id exactly
        tm, sem = syntax or ({}, {})
        data["editor.tokenColorCustomizations"] = {scope: tm} if syntax else {}
        data["editor.semanticTokenColorCustomizations"] = {scope: sem} if syntax else {}
        p.write_text(json.dumps(data, indent=4, ensure_ascii=False) + "\n")
    except json.JSONDecodeError:
        # settings.json with comments: patch the single key in place
        if '"workbench.colorTheme"' in text:
            text = re.sub(r'"workbench\.colorTheme"\s*:\s*"[^"]*"', f'"workbench.colorTheme": "{theme_name}"', text)
        else:
            text = text.replace("{", "{\n    \"workbench.colorTheme\": \"%s\"," % theme_name, 1)
        p.write_text(text)


