def vscode_syntax(t, c):
    """Syntax colours from the palette roles (Catppuccin-style mapping), for themes without a
    VS Code extension of their own (the wallpaper themes run on Default Dark/Light Modern)."""
    rules = [
        (["comment", "punctuation.definition.comment"], c["overlay1"], "italic"),
        (["string", "punctuation.definition.string"], c["green"], ""),
        (["string.regexp", "constant.character.escape"], c["pink"], ""),
        (["constant.numeric", "constant.language", "constant.other", "support.constant"], c["peach"], ""),
        (["keyword", "storage", "storage.type", "storage.modifier", "keyword.control"], c["mauve"], ""),
        (["keyword.operator", "punctuation.accessor", "punctuation.separator.key-value"], c["sky"], ""),
        (["entity.name.function", "support.function", "meta.function-call entity.name.function"], c["blue"], ""),
        (["entity.name.type", "entity.name.class", "support.type", "support.class",
          "entity.other.inherited-class", "entity.name.namespace"], c["yellow"], ""),
        (["variable", "variable.other"], c["text"], ""),
        (["variable.parameter"], c["red"], "italic"),
        (["variable.language"], c["red"], "italic"),
        (["variable.other.property", "support.variable.property", "meta.object-literal.key",
          "support.type.property-name"], c["lavender"], ""),
        (["entity.name.tag"], c["blue"], ""),
        (["entity.other.attribute-name"], c["yellow"], "italic"),
        (["meta.decorator", "entity.name.function.decorator", "punctuation.decorator"], c["peach"], ""),
        (["punctuation", "meta.brace"], c["subtext0"], ""),
        (["markup.heading", "entity.name.section"], c["accent"], "bold"),
        (["markup.bold"], c["text"], "bold"), (["markup.italic"], c["text"], "italic"),
        (["markup.inline.raw", "markup.fenced_code"], c["green"], ""),
        (["markup.underline.link"], c["blue"], "underline"),
        (["markup.inserted"], c["green"], ""), (["markup.deleted"], c["red"], ""),
    ]
    tm = []
    for scopes, fg, style in rules:
        s = {"foreground": fg}
        if style:
            s["fontStyle"] = style
        tm.append({"scope": scopes, "settings": s})
    semantic = {
        "function": c["blue"], "method": c["blue"], "parameter": {"foreground": c["red"], "italic": True},
        "property": c["lavender"], "variable": c["text"], "variable.readonly": c["peach"],
        "type": c["yellow"], "class": c["yellow"], "interface": c["yellow"], "enum": c["yellow"],
        "struct": c["yellow"], "namespace": c["yellow"], "typeParameter": c["yellow"],
