    patched = (sdir / "Apps/xpui").is_dir() and not (sdir / "Apps/xpui.spa").exists()
    cmd = ["refresh"] if patched and has_live else (["apply"] if patched else ["backup", "apply"])
    r = subprocess.run([SPICETIFY, "-q", "-n", *cmd], capture_output=True, text=True, timeout=120,
