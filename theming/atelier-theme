def t_starship(t, c):
    """Re-map the existing mocha palette onto this theme (keeps your prompt layout)."""
    global MOCHA_ROLES
    p = CONF / "starship.toml"
    if not p.exists():
        return
    s = p.read_text()
    m = re.search(r"(?ms)^\[palettes\.mocha\]\n(.*?)(?=^\[|\Z)", s)
    if not m:
        return
    mocha = themes().get("catppuccin-mocha")
    if not mocha:
        return
    ref = {k: rgb(v) for k, v in mocha["colors"].items()}

    def nearest(h):
        x = rgb(h)
        return min(ref, key=lambda k: sum((a - b) ** 2 for a, b in zip(ref[k], x)))

    out = [f"[palettes.atelier]  # generated by atelier-theme ({t['name']})"]
    for line in m.group(1).splitlines():
        km = re.match(r'\s*([\w-]+)\s*=\s*"(#[0-9a-fA-F]{6})"', line)
        if km:
            out.append(f'{km.group(1)} = "{c[nearest(km.group(2))]}"')
    s = re.sub(r"(?ms)^\[palettes\.atelier\].*?(?=^\[|\Z)", "", s).rstrip() + "\n\n" + "\n".join(out) + "\n"
    s = re.sub(r'(?m)^palette\s*=\s*".*"$', 'palette = "atelier"', s)
    p.write_text(s)


