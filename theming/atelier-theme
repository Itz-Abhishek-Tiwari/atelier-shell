# ── wallpaper themes ─────────────────────────────────────────────────────────
# "wallpaper-dark" / "wallpaper-light": palettes built around the wallpaper's main colour (OKLCH,
# Material-You-like). Written to ~/.config/atelier/themes and regenerated when the wallpaper changes.
WALL_FILE = HOME / ".cache/current_wallpaper"
WALL_IDS = ("wallpaper-dark", "wallpaper-light")
# semantic roles keep their meaning (red = error …); hues in OKLCH degrees
ROLE_HUES = {"red": 20, "peach": 50, "yellow": 95, "green": 145, "teal": 180, "sky": 215,
             "sapphire": 235, "blue": 260, "lavender": 280, "mauve": 305, "pink": 345}


def _lin(u):
    return u / 12.92 if u <= 0.04045 else ((u + 0.055) / 1.055) ** 2.4


def _gam(u):
    return 12.92 * u if u <= 0.0031308 else 1.055 * u ** (1 / 2.4) - 0.055


def oklch_of(r, g, b):
    import math
    r, g, b = (_lin(x / 255) for x in (r, g, b))
    l = (0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b) ** (1 / 3)
    m = (0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b) ** (1 / 3)
    s = (0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b) ** (1 / 3)
    L = 0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s
    A = 1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s
    B = 0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s
    return L, math.hypot(A, B), math.degrees(math.atan2(B, A)) % 360


def oklch_hex(L, C, H):
    """OKLCH → #rrggbb, reducing chroma until the colour fits sRGB."""
    import math
    for _ in range(40):
        a, b = C * math.cos(math.radians(H)), C * math.sin(math.radians(H))
        l = (L + 0.3963377774 * a + 0.2158037573 * b) ** 3
        m = (L - 0.1055613458 * a - 0.0638541728 * b) ** 3
        s = (L - 0.0894841775 * a - 1.2914855480 * b) ** 3
        rgb_ = (4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
                -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
                -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s)
        if all(-1e-4 <= v <= 1.0001 for v in rgb_) or C < 1e-3:
            return "#" + "".join(f"{round(max(0, min(1, _gam(max(0, v)))) * 255):02x}" for v in rgb_)
        C *= 0.92
    return "#808080"


def wallpaper_analyse(path):
    """The wallpaper's real colours: tint of its darks and lights, plus up to two accent colours."""
    import math
    from PIL import Image
    im = Image.open(path)
    im.seek(0)
    im = im.convert("RGB")
    im.thumbnail((160, 160))
    q = im.quantize(colors=32, method=Image.Quantize.MEDIANCUT)
    pal = q.getpalette()
    counts = q.getcolors(256) or []
    total = sum(n for n, _ in counts) or 1
    cl = []
    for n, i in counts:
        L, C, H = oklch_of(*pal[i * 3:i * 3 + 3])
        cl.append((L, C, H, n / total))

    def tint(sel):                                     # share-weighted mean in a/b → (C, H)
        w = sum(x[3] for x in sel)
        if not w:
            return 0.0, 0.0
        A = sum(x[1] * math.cos(math.radians(x[2])) * x[3] for x in sel) / w
        B = sum(x[1] * math.sin(math.radians(x[2])) * x[3] for x in sel) / w
        return math.hypot(A, B), math.degrees(math.atan2(B, A)) % 360

    dark = tint([x for x in cl if x[0] < 0.5]) if any(x[0] < 0.5 for x in cl) else tint(cl)
    light = tint([x for x in cl if x[0] > 0.65]) if any(x[0] > 0.65 for x in cl) else tint(cl)
    # accent candidates: real colours (not greys), scored by how much of the image they cover × chroma
    cand = sorted((x for x in cl if x[1] >= 0.045 and 0.25 <= x[0] <= 0.93),
                  key=lambda x: -(x[3] ** 0.5) * min(x[1], 0.2))
    seeds = []
    for x in cand:
        if all(abs((x[2] - y[2] + 540) % 360 - 180) > 35 for y in seeds):
            seeds.append(x)
        if len(seeds) == 2:
            break
    return {"dark": dark, "light": light, "seeds": seeds}


def wallpaper_theme(w, dark):
    seeds = w["seeds"]
    mono = not seeds                                   # black-and-white / grey wallpaper
    nC, nH = w["dark"] if dark else w["light"]
    nC = min(nC, 0.035)
    H = seeds[0][2] if seeds else nH
    vivid = min(1.0, max(0.35, (seeds[0][1] / 0.12) if seeds else 0.35))   # wallpaper colourfulness

    def harm(h):                                       # pull role hues toward the wallpaper's hue
        d = (H - h + 540) % 360 - 180
        return (h + max(-15, min(15, d * 0.25))) % 360

    if dark:
        neutrals = {"crust": .14, "mantle": .17, "base": .205, "surface0": .26, "surface1": .31, "surface2": .36,
                    "overlay0": .50, "overlay1": .58, "subtext0": .75, "subtext1": .82, "text": .92}
        roleL, accL = .80, (.70, .86)
    else:
        neutrals = {"crust": .88, "mantle": .925, "base": .965, "surface0": .895, "surface1": .855, "surface2": .80,
                    "overlay0": .62, "overlay1": .55, "subtext0": .45, "subtext1": .38, "text": .26}
        roleL, accL = .56, (.42, .58)
    roleC = (.11 if dark else .14) * vivid
    colors = {k: oklch_hex(L, nC, nH) for k, L in neutrals.items()}
    for role, h in ROLE_HUES.items():
        colors[role] = oklch_hex(roleL + (.07 if role == "yellow" else 0), roleC, harm(h))

    def nearest(h, taken=()):
        return min((r for r in ROLE_HUES if r not in taken),
                   key=lambda r: abs((ROLE_HUES[r] - h + 540) % 360 - 180))

    if mono:
        # the wallpaper has no colour: accent is its own light (dark theme) / dark (light theme) tone
        accent = "lavender"                            # a decorative slot: keep red/yellow/green meaningful
        colors[accent] = oklch_hex(.88 if dark else .30, nC, nH)
    else:
        taken = []
        for sL, sC, sH, _ in seeds:                    # put the real wallpaper colours in the palette
            r = nearest(sH, taken)
            taken.append(r)
            colors[r] = oklch_hex(max(accL[0], min(accL[1], sL)), min(sC, 0.18), sH)
        accent = taken[0]
    c = colors
    if dark:
        ansi = [c["surface1"], c["red"], c["green"], c["yellow"], c["blue"], c["pink"], c["teal"], c["subtext1"],
                c["surface2"], c["red"], c["green"], c["yellow"], c["blue"], c["pink"], c["teal"], c["subtext0"]]
    else:
        ansi = [c["subtext1"], c["red"], c["green"], c["yellow"], c["blue"], c["pink"], c["teal"], c["surface2"],
                c["subtext0"], c["red"], c["green"], c["yellow"], c["blue"], c["pink"], c["teal"], c["surface1"]]
    v = "dark" if dark else "light"
    return {
        "id": f"wallpaper-{v}", "name": f"Wallpaper {v.title()}", "variant": v, "accent": accent,
        "pair": "wallpaper-light" if dark else "wallpaper-dark",
        "description": "Monochrome, from your wallpaper" if mono else "Colours from your wallpaper",
        "colors": colors, "ansi": ansi,
        "vscode": {"theme": "Dark Modern" if dark else "Light Modern"},
        "bat": "base16",
    }


def cmd_wallpaper(path=None, force=False):
    """Regenerate the wallpaper themes; re-apply if one of them is active."""
    path = path or (WALL_FILE.read_text().strip() if WALL_FILE.exists() else "")
    if not path or not Path(path).is_file():
        sys.exit(f"no wallpaper image: {path!r}")
    p = Path(path)
    stamp = f"{p.resolve()}:{p.stat().st_mtime_ns}"
    prev = USER_THEMES / "wallpaper-dark.json"
    try:
        same = json.loads(prev.read_text()).get("source") == stamp
    except Exception:
        same = False
    cur = state().get("current", "")
    if not (same and not force):
        w = wallpaper_analyse(path)
        for dark in (True, False):
            t = wallpaper_theme(w, dark)
            t["source"] = stamp
            write(USER_THEMES / f"{t['id']}.json", json.dumps(t, indent=2))
    if cur in WALL_IDS and not (same and not force):
        apply(cur)
    else:
        print(json.dumps({"status": "ok", "generated": not same, "applied": False}))


def cmd_list():
    cur = state().get("current", "")
    out = []
    for t in themes().values():
        c = resolved(t)
        out.append({"id": t["id"], "name": t["name"], "variant": t["variant"], "description": t.get("description", ""),
                    "current": t["id"] == cur,
                    "swatch": {k: c[k] for k in ("base", "mantle", "crust", "surface0", "surface1", "surface2",
                                                 "text", "subtext0", "subtext1", "accent", "onAccent", "mauve",
                                                 "red", "peach", "yellow", "green", "teal", "sapphire", "blue",
                                                 "lavender", "pink") if k in c}})
    out.sort(key=lambda x: (x["variant"] != "dark", x["name"]))
    print(json.dumps(out, ensure_ascii=False))


def toggle_mode():
    ts = themes()
    s = state()
    cur = ts.get(s.get("current", ""), ts.get("catppuccin-mocha"))
    target = cur.get("pair") or ""
    if target not in ts:
        want = "light" if cur["variant"] == "dark" else "dark"
        target = s.get("last_" + want) or ("catppuccin-latte" if want == "light" else "catppuccin-mocha")
    apply(target)


def setup():
    """Install every theme's VS Code extension + the minimal icon themes (one-time, needs network)."""
    exts = sorted({(t.get("vscode") or {}).get("extension") for t in themes().values()} - {None, ""})
    exts += ["miguelsolorio.symbols", "miguelsolorio.fluent-icons"]   # file icons + product icons
    for editor in ("code", "antigravity"):
        if not shutil.which(editor):
            continue
        try:
            have = subprocess.run([editor, "--list-extensions"], capture_output=True, text=True, timeout=60).stdout.lower().split()
        except Exception:
            have = []
        for e in exts:
            if e.lower() not in have:
                print(f"{editor}: installing {e}", flush=True)
                subprocess.run([editor, "--install-extension", e], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def main():
    if len(sys.argv) < 2:
        print(__doc__)
        return
    cmd = sys.argv[1]
    if cmd == "list":
        cmd_list()
    elif cmd == "current":
        print(state().get("current", ""))
    elif cmd == "apply" and len(sys.argv) > 2:
        apply(sys.argv[2])
    elif cmd == "toggle-mode":
        toggle_mode()
    elif cmd == "wallpaper":
        args = [a for a in sys.argv[2:] if a != "--force"]
        cmd_wallpaper(args[0] if args else None, "--force" in sys.argv)
    elif cmd == "setup":
        setup()
    else:
        print(__doc__)


if __name__ == "__main__":
    main()
